{
  "name": "abraham",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "homepage": "https://abrahamparn.github.io/",
  "scripts": {
    "dev": "vite ",
    "build": "vite build && node --import tsx scripts/prerender.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" vite.config.js eslint.config.js playwright.config.ts --max-warnings 0",
    "lint:legacy": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext js,jsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "netlify": "netlify",
    "netlifyLogin": "netlify login",
    "netlifyStopTelemetry": "netlify --telemetry-disable",
    "netlifyInit": "netlify init",
    "netlifyUnlink": "netlify unlink",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --cname abrahamnaiborhu.me"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@react-spring/parallax": "^9.7.3",
    "@studio-freight/lenis": "^1.0.27",
    "flowbite": "^1.8.1",
    "flowbite-react": "^0.5.0",
    "gsap": "^3.12.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.17.0",
    "react-router-hash-link": "^2.4.3",
    "react-scroll-parallax": "^3.4.3",
    "react-use": "^17.6.0",
    "split-type": "^0.3.4",
    "tailwind-scrollbar-hide": "^1.1.7"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.19.15",
    "@vitejs/plugin-react": "5.2.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "tsx": "4.21.0",
    "autoprefixer": "^10.4.15",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.2.0",
    "netlify-cli": "^17.2.2",
    "postcss": "^8.4.29",
    "tailwindcss": "^3.3.3",
    "vite": "7.3.6"
  }
}
